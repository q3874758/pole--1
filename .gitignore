# Build output
/target/
**/target/

# Local Go toolchain caches (sandbox workaround: GOCACHE/GOPATH/GOENV
# pointed into the workspace so `go` can build inside the DSH ACL sandbox)
/.gocache/
/.gopath/
/.goenv

# Runtime data
/pole-node-data/
**/pole-node-data/

# Logs and pids
*.log
*.pid
*.pid.lock

# ----------------------------------------------------------------------------
# Go chain (chain/) — built by `cd chain && go build ./cmd/poled`
# ----------------------------------------------------------------------------
# Compiled binary (162 MB on Windows). Use GitHub Releases, not LFS.
chain/poled
chain/poled.exe
chain/poled.dSYM/
# Go build cache & dist
chain/build/
chain/dist/
# Runtime tempdir that poled creates on startup. Holds
# `data/application.db/`, `config/genesis.json`, etc.
chain/.tmp-poled-home/
**/.tmp-poled-home/

# ----------------------------------------------------------------------------
# Bundled toolchains (extracted once, then ignored)
# ----------------------------------------------------------------------------
tools/wix/
tools/wix314-binaries.zip
tools/wix.zip
tools/wix*.zip

# ----------------------------------------------------------------------------
# Distribution / packaging output
# ----------------------------------------------------------------------------
dist/click-to-run/
dist/packages/
**/dist/

# ----------------------------------------------------------------------------
# Binaries in general — keep them out of the source tree
# ----------------------------------------------------------------------------
*.exe
*.zip
*.tar.gz
*.tgz
*.dmg
*.msi
*.deb
*.rpm
*.appimage
*.snap
*.pdb
*.so
*.dylib
*.dll
*.a
*.lib

# ----------------------------------------------------------------------------
# IDE / editor
# ----------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
.bundle/
*.sublime-project
*.sublime-workspace

# ----------------------------------------------------------------------------
# OS files
# ----------------------------------------------------------------------------
*.tmp
*.bak
*.orig
*.rej
*.sw?

# ----------------------------------------------------------------------------
# Secrets — never commit
# ----------------------------------------------------------------------------
.env
.env.local
.env.*.local
secrets/
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519

# ----------------------------------------------------------------------------
# AI-agent working artifacts (not source; keep out of the repo)
# ----------------------------------------------------------------------------
/.opencode/
/.mavis/
/plans/

# ----------------------------------------------------------------------------
# Runtime state / generated artifacts (node config, SBOM output, push logs, test data)
# ----------------------------------------------------------------------------
/.tmp-pole-node.json
/client-config.json
/node.json
/node-a.json
/node-b.json
/pole-gui-state.json
/pole-node-config.toml
/push_log.txt
/push_result*.txt
/sbom.cdx.json
/sbom.spdx.json
/test-wallet-data/
/pole-node-data-a/
/pole-node-data-b/

# poled runtime home (created when run without --home)
**/.pole/

# ----------------------------------------------------------------------------
# Vendored dependencies (cargo vendor snapshot)
# ----------------------------------------------------------------------------
# Only core2 is committed: it is a patched crate (a minimal MIT stub replacing
# the upstream no_std core2) referenced via [patch.crates-io], so a fresh clone
# needs it to build. The rest of vendor/ is a local `cargo vendor` snapshot.
/vendor/*
!/vendor/core2/
